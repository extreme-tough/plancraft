# Copy to .env.local for local development. Never commit real values.

# development | test | production. App Hosting sets production (apphosting.yaml).
APP_ENV=development

# vertex | fixture. Tests and E2E use fixture; production refuses it (AI-05).
AI_PROVIDER=fixture
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AI_DAILY_CAP=2000

# Firebase web config is public by design (not a secret); its API key is referrer-restricted.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
