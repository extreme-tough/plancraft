# Copy to .env.local for local development. Never commit real values.

# development | test | production. App Hosting sets production (apphosting.yaml).
APP_ENV=development

# vertex | fixture. Tests and E2E use fixture; production refuses it (AI-05).
AI_PROVIDER=fixture
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
AI_DAILY_CAP=2000

# Firebase web config is public by design (not a secret); its API key is referrer-restricted.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# EM-67 moodboard bucket, e.g. <project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# EM-63: the nightly demo reset accepts only Cloud Scheduler's OIDC token for this account and URL.
# Leave empty locally: the reset route is then off (docs/setup.md section 8).
DEMO_RESET_INVOKER=
DEMO_RESET_AUDIENCE=
